{
  "form_name": "INDIVIDUAL",
  "catalog_version": "nao-cat-2026.09.1",
  "total_attributes": 27,
  "groups": [
    {
      "group": "account_setup",
      "label": "Account Setup",
      "order": 1,
      "attributes": [
        {
          "key": "account.type",
          "label": "Account Type",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "INDIVIDUAL",
            "JOINT_WROS",
            "TRADITIONAL_IRA",
            "REVOCABLE_TRUST",
            "UTMA"
          ],
          "note": "Five registrations. Drives everything else."
        },
        {
          "key": "account.advisory_program",
          "label": "Advisory Program",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "ADVISOR_DRIVEN",
            "UMA",
            "THIRD_PARTY_MF",
            "DIGITAL_ADVICE"
          ],
          "note": "Fee schedule and which rules apply."
        },
        {
          "key": "account.purpose",
          "label": "Account Purpose",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "RETIREMENT",
            "EDUCATION",
            "WEALTH_ACCUMULATION",
            "INCOME",
            "ESTATE_PLANNING"
          ],
          "note": "Free speech is mapped to one option."
        }
      ]
    },
    {
      "group": "applicant_identity",
      "label": "Applicant Identity",
      "order": 2,
      "attributes": [
        {
          "key": "applicant.legal_name",
          "label": "Legal Name",
          "type": "composite",
          "required": "always",
          "pii": "direct",
          "composite_fields": {
            "first": {
              "type": "string",
              "required": true
            },
            "middle": {
              "type": "string",
              "required": false
            },
            "last": {
              "type": "string",
              "required": true
            },
            "suffix": {
              "type": "string",
              "required": false
            }
          },
          "note": "Must match the ID exactly."
        },
        {
          "key": "applicant.date_of_birth",
          "label": "Date of Birth",
          "type": "date",
          "required": "always",
          "pii": "direct",
          "note": "Secure field. The agent never sees it."
        },
        {
          "key": "applicant.tax_id",
          "label": "Tax ID (SSN/ITIN)",
          "type": "masked",
          "required": "always",
          "pii": "sensitive",
          "note": "Secure field. The agent never sees it."
        },
        {
          "key": "applicant.citizenship_status",
          "label": "Citizenship Status",
          "type": "enum",
          "required": "always",
          "pii": "indirect",
          "enum_values": [
            "US_CITIZEN",
            "US_RESIDENT_ALIEN",
            "NON_RESIDENT_ALIEN"
          ],
          "note": "Decides which tax form is generated."
        },
        {
          "key": "applicant.legal_address",
          "label": "Legal Address",
          "type": "address",
          "required": "always",
          "pii": "direct",
          "composite_fields": {
            "line1": {
              "type": "string",
              "required": true
            },
            "line2": {
              "type": "string",
              "required": false
            },
            "city": {
              "type": "string",
              "required": true
            },
            "state": {
              "type": "string",
              "required": true
            },
            "postal_code": {
              "type": "string",
              "required": true
            },
            "country": {
              "type": "string",
              "required": true
            }
          },
          "note": "No PO box. State affects spousal rules."
        },
        {
          "key": "applicant.email",
          "label": "Email Address",
          "type": "email",
          "required": "always",
          "pii": "direct",
          "note": "Where signing requests are sent."
        },
        {
          "key": "applicant.mobile_phone",
          "label": "Mobile Phone",
          "type": "phone",
          "required": "always",
          "pii": "direct",
          "note": "Used for the security code at signing."
        }
      ]
    },
    {
      "group": "employment_finances",
      "label": "Employment & Finances",
      "order": 3,
      "attributes": [
        {
          "key": "employment.status",
          "label": "Employment Status",
          "type": "enum",
          "required": "always",
          "pii": "indirect",
          "enum_values": [
            "EMPLOYED",
            "SELF_EMPLOYED",
            "RETIRED",
            "STUDENT",
            "NOT_EMPLOYED"
          ],
          "note": "Opens the employer question."
        },
        {
          "key": "employment.employer_name",
          "label": "Employer Name",
          "type": "text",
          "required": "conditional",
          "pii": "indirect",
          "condition": "employment.status IN [EMPLOYED, SELF_EMPLOYED]",
          "note": "Only if employed or self-employed."
        },
        {
          "key": "financial.annual_income",
          "label": "Annual Income",
          "type": "enum",
          "required": "always",
          "pii": "indirect",
          "enum_values": [
            "UNDER_50K",
            "50K_100K",
            "100K_250K",
            "250K_500K",
            "OVER_500K"
          ],
          "note": "Banded, never an exact figure."
        },
        {
          "key": "financial.liquid_net_worth",
          "label": "Liquid Net Worth",
          "type": "enum",
          "required": "always",
          "pii": "indirect",
          "enum_values": [
            "UNDER_50K",
            "50K_250K",
            "250K_1M",
            "1M_5M",
            "OVER_5M"
          ],
          "note": "Checked against the funding amount."
        }
      ]
    },
    {
      "group": "household",
      "label": "Household",
      "order": 4,
      "attributes": [
        {
          "key": "household.dependants",
          "label": "Number of Dependants",
          "type": "integer",
          "required": "optional",
          "pii": "indirect",
          "note": "Context for planning. Not on the custodian form."
        },
        {
          "key": "household.minor_dependants",
          "label": "Minor Dependants (under 18)",
          "type": "integer",
          "required": "optional",
          "pii": "indirect",
          "note": "Drives the education-funding prompt and UTMA suggestion."
        }
      ]
    },
    {
      "group": "investment_profile",
      "label": "Investment Profile",
      "order": 5,
      "attributes": [
        {
          "key": "profile.investment_objective",
          "label": "Investment Objective",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "CAPITAL_PRESERVATION",
            "INCOME",
            "GROWTH_AND_INCOME",
            "GROWTH",
            "SPECULATION"
          ],
          "note": "Limits which portfolios are allowed."
        },
        {
          "key": "profile.risk_tolerance",
          "label": "Risk Tolerance",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "CONSERVATIVE",
            "MOD_CONSERVATIVE",
            "MODERATE",
            "MOD_AGGRESSIVE",
            "AGGRESSIVE"
          ],
          "note": "The most important cross-check in the set."
        },
        {
          "key": "profile.time_horizon",
          "label": "Time Horizon",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "UNDER_3Y",
            "3_5Y",
            "5_10Y",
            "OVER_10Y"
          ],
          "note": "Short horizon plus aggressive objective is flagged."
        }
      ]
    },
    {
      "group": "regulatory",
      "label": "Regulatory Questions",
      "order": 6,
      "attributes": [
        {
          "key": "reg.finra_affiliation",
          "label": "FINRA Affiliation",
          "type": "boolean",
          "required": "always",
          "pii": "indirect",
          "note": "Yes means an approval letter is required first."
        },
        {
          "key": "reg.control_person",
          "label": "Control Person",
          "type": "boolean",
          "required": "always",
          "pii": "indirect",
          "note": "Yes means the company ticker is captured."
        }
      ]
    },
    {
      "group": "trusted_contact",
      "label": "Trusted Contact",
      "order": 10,
      "attributes": [
        {
          "key": "trusted_contact",
          "label": "Trusted Contact Person",
          "type": "composite",
          "required": "always",
          "pii": "direct",
          "composite_fields": {
            "name": {
              "type": "string",
              "required": true
            },
            "relationship": {
              "type": "string",
              "required": true
            },
            "phone": {
              "type": "phone",
              "required": true
            },
            "email": {
              "type": "email",
              "required": false
            },
            "declined": {
              "type": "boolean",
              "required": false
            }
          },
          "note": "Can be declined, but the decline is recorded."
        }
      ]
    },
    {
      "group": "funding",
      "label": "Funding",
      "order": 11,
      "attributes": [
        {
          "key": "funding.method",
          "label": "Funding Method",
          "type": "enum",
          "required": "always",
          "pii": "none",
          "enum_values": [
            "ACAT_TRANSFER",
            "ACH",
            "CHECK",
            "WIRE",
            "IRA_ROLLOVER"
          ],
          "note": "Opens the delivering-institution section."
        },
        {
          "key": "funding.initial_amount",
          "label": "Initial Funding Amount",
          "type": "currency",
          "required": "always",
          "pii": "indirect",
          "note": "Checked against declared net worth."
        },
        {
          "key": "funding.delivering_institution",
          "label": "Delivering Institution",
          "type": "composite",
          "required": "conditional",
          "pii": "sensitive",
          "condition": "funding.method IN [ACAT_TRANSFER, IRA_ROLLOVER]",
          "composite_fields": {
            "institution_name": {
              "type": "string",
              "required": true
            },
            "account_number": {
              "type": "masked",
              "required": true
            },
            "registration_type": {
              "type": "string",
              "required": true
            },
            "registration_id": {
              "type": "string",
              "required": true
            },
            "transfer_scope": {
              "type": "string",
              "required": true,
              "enum_values": [
                "FULL",
                "PARTIAL"
              ]
            }
          },
          "note": "Registration must match or the transfer bounces."
        }
      ]
    },
    {
      "group": "disclosures",
      "label": "Disclosures",
      "order": 12,
      "attributes": [
        {
          "key": "disclosure.form_crs_ack",
          "label": "Form CRS Acknowledgement",
          "type": "attestation",
          "required": "always",
          "pii": "none",
          "note": "Exact approved wording only."
        },
        {
          "key": "disclosure.advisory_agreement_ack",
          "label": "Advisory Agreement Acknowledgement",
          "type": "attestation",
          "required": "always",
          "pii": "none",
          "note": "Exact approved wording only."
        }
      ]
    }
  ],
  "section_triggers": [
    {
      "when": "funding.method IN [ACAT_TRANSFER, IRA_ROLLOVER]",
      "opens": "funding.delivering_institution",
      "closes": null
    },
    {
      "when": "employment.status IN [EMPLOYED, SELF_EMPLOYED]",
      "opens": "employment.employer_name",
      "closes": null
    },
    {
      "when": "reg.finra_affiliation = true",
      "opens": "finra_approval_letter_upload",
      "closes": null
    }
  ]
}